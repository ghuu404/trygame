<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>行医 · 问诊</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; overflow: hidden; }
  body {
    font-family: sans-serif; user-select: none;
    background: #f5f0e8;
    display: flex; flex-direction: column; align-items: center;
  }
  #app {
    width: 100%; max-width: 440px; height: 100%;
    display: flex; flex-direction: column;
    position: relative;
  }

  /* ===== 顶部栏 ===== */
  #topBar {
    height: 46px; display: flex; align-items: center;
    padding: 0 12px; gap: 10px;
    background: #558b2f; color: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    flex-shrink: 0; z-index: 5;
  }
  .icon-btn {
    background: rgba(255,255,255,0.18); border: none; color: #fff;
    font-size: 18px; width: 34px; height: 34px; border-radius: 8px;
    cursor: pointer;
  }
  .icon-btn:active { transform: scale(0.92); }
  #progress { flex: 1; text-align: center; font-size: 14px; font-weight: bold; }
  #coinTag {
    font-size: 13px; font-weight: bold;
    background: rgba(255,255,255,0.2);
    padding: 4px 10px; border-radius: 12px;
  }

  /* ===== 舞台 ===== */
  #stage {
    flex: 1; position: relative; overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 100%, #d9c8a8 0%, transparent 70%),
      linear-gradient(180deg, #efe6d4 0%, #e0d2b8 100%);
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: 6px;
  }
  #patientWrap {
    width: 62%; max-width: 260px; height: 88%;
    display: flex; align-items: flex-end; justify-content: center;
    transition: transform 0.35s ease, opacity 0.35s;
  }
  #patientWrap.enter { transform: translateX(120%); opacity: 0; }
  #patientWrap.leave { transform: translateX(140%) rotate(6deg); opacity: 0; }
  #patientWrap svg { width: 100%; height: 100%; display: block; }

  /* 病人小动作 */
  @keyframes shiver {
    0%,100% { transform: translateX(0); }
    25% { transform: translateX(-2px); }
    75% { transform: translateX(2px); }
  }
  .shiver { animation: shiver 0.35s infinite; }
  @keyframes breathe {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.015); }
  }
  .breathe { animation: breathe 3s ease-in-out infinite; }

  /* hotspot */
  .hotspot {
    cursor: pointer;
    pointer-events: all;
  }
  .hotspot.pulse {
    animation: hotspotPulse 1.2s infinite;
  }
  @keyframes hotspotPulse {
    0%,100% { opacity: 0; }
    50% { opacity: 0.55; }
  }

  /* ===== 气泡 ===== */
  #bubble {
    position: absolute; top: 12px; left: 50%;
    transform: translateX(-50%) scale(0.9);
    background: #fff; border: 2px solid #558b2f;
    border-radius: 14px; padding: 10px 16px;
    font-size: 14px; color: #2a3a1a; font-weight: bold;
    max-width: 78%; line-height: 1.4;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    opacity: 0; transition: all 0.25s ease;
    z-index: 3; text-align: center;
  }
  #bubble::after {
    content: ''; position: absolute; bottom: -10px; left: 50%;
    transform: translateX(-50%);
    border: 8px solid transparent;
    border-top-color: #558b2f;
  }
  #bubble.show { opacity: 1; transform: translateX(-50%) scale(1); }

  /* ===== 病历面板 ===== */
  #casePanel {
    background: #fff; border-top: 2px solid #d4c4a8;
    padding: 8px 14px; min-height: 60px; max-height: 92px;
    overflow-y: auto; font-size: 12px; color: #5a4a30;
    flex-shrink: 0;
  }
  .case-title {
    font-size: 12px; font-weight: bold; color: #33691e;
    margin-bottom: 4px;
  }
  #caseContent { line-height: 1.6; }
  #caseContent .sym { color: #b34100; }
  #caseContent .pulse { color: #1565c0; }

  /* ===== 操作区 ===== */
  #actionArea {
    padding: 10px 14px 16px; background: #efe6d4;
    border-top: 2px solid #d4c4a8; flex-shrink: 0;
    min-height: 76px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .action-tip {
    font-size: 13px; color: #6b5a3a; text-align: center;
    font-weight: bold; line-height: 1.4;
  }
  .action-btn {
    display: block; width: 100%; font-size: 15px; font-weight: bold;
    padding: 11px; border: 2px solid #558b2f; border-radius: 12px;
    background: #aed581; color: #33691e; cursor: pointer;
    transition: all 0.15s;
  }
  .action-btn:active { transform: scale(0.97); }
  .action-btn.secondary {
    background: #fff; border-color: #8b7355; color: #5a4a30;
  }
  .option-btn {
    display: block; width: 100%; text-align: left;
    font-size: 15px; font-weight: bold;
    padding: 12px 16px; margin-bottom: 6px;
    border: 2px solid #8b7355; border-radius: 12px;
    background: #fff; color: #4a3a20; cursor: pointer;
    transition: all 0.15s;
  }
  .option-btn:active { transform: scale(0.98); background: #f0e6d0; }
  .option-btn.correct {
    background: #c5e1a5; border-color: #33691e; color: #1a3a00;
  }
  .option-btn.wrong {
    background: #ffcdd2; border-color: #c62828; color: #